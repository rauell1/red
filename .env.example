# Neon PostgreSQL HTTP connection string (optional for preview; required for persistent production data)
DATABASE_URL=

# Admin sign-in. Preview falls back to red-admin-demo when unset.
ADMIN_PASSWORD=

# Long random secret used to HMAC-sign the admin session cookie.
SESSION_SECRET=

# Optional: the dev server defaults to port 3000. Vite preview runs on port 5000.
PORT=3000
