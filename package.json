{
  "name": "red-nyekunduuu-creator-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c red,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx src/dev-server.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5000",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "start": "NODE_ENV=production tsx src/dev-server.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@neondatabase/serverless": "^0.10.4",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.16",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
